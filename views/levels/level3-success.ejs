<%- include('../partials/header', { pageTitle: 'Lv3 登入成功' }) %>

<div class="wrap">

  <div class="pg-header fi">
    <div class="pg-lv">LV 03 / 03 &nbsp;·&nbsp; 完成</div>
    <div class="pg-title">Authentication Bypass — 成功</div>
  </div>

  <div class="term fi" style="margin-bottom:20px">
    <div class="term-bar">
      <span class="dot dot-r"></span>
      <span class="dot dot-y"></span>
      <span class="dot dot-g"></span>
      <span style="margin-left:8px">session — campus-verify.sch00l-p0rtal.xyz</span>
    </div>
    <div class="term-body">
      <div class="t-d">$ cat session.log</div>
      <div style="margin-top:8px">
        <div class="t-g">✓ LOGIN SUCCESS</div>
        <div style="margin-top:6px;line-height:2">
          <span class="t-d">user_id  :</span>
          <span class="t-a"> s1234567</span><br>
          <span class="t-d">name     :</span>
          <span> 王小明</span><br>
          <span class="t-d">role     :</span>
          <span> student</span><br>
          <span class="t-d">session  :</span>
          <span class="t-d"> [已建立，可在 F12 → Application → Cookies 查看]</span>
        </div>
        <div style="margin-top:10px" class="t-a">
          本關得分：<strong><%= score %> pt</strong>
        </div>
      </div>
    </div>
  </div>

  <div class="alert alert-g fi">
    ✓ 第3關完成！成功以弱密碼登入假校務系統。<br>
    <span style="font-size:12px;color:var(--text-dim)">
      現在你已取得一個合法的 session。
      下一關：試著在系統的資源下載區找到不該被存取的檔案。
    </span>
  </div>

  <div style="margin-top:16px" class="fi">
    <a href="/" class="btn btn-d" style="margin-right:10px">← 返回選單</a>
    <span style="font-size:12px;color:var(--text-dim)">（第4關建置中）</span>
  </div>

</div>

<%- include('../partials/footer') %>