<%- include('../partials/header', { pageTitle: 'Lv6 Cookie 存取' }) %>

<div class="wrap">

  <div class="pg-header fi">
    <div class="pg-lv">LV 06 / 06 &nbsp;·&nbsp; Cookie 存取</div>
    <div class="pg-title">Cookie Manipulation</div>
    <div class="pg-sub">
      滿分 120 pt &nbsp;·&nbsp; 每答錯 -20 &nbsp;·&nbsp; 使用提示 -50 &nbsp;·&nbsp; 最低 0
    </div>
  </div>

  <!-- 門禁系統模擬 -->
  <div class="fi" style="margin-bottom:16px">
    <div style="border:1px solid var(--border);border-radius:4px;
                background:#0a0a0a;overflow:hidden">
      <div style="background:#111;padding:10px 16px;border-bottom:1px solid var(--border);
                  font-size:12px;color:var(--text-dim);font-family:var(--font)">
        🔒 campus-verify.sch00l-p0rtal.xyz/admin
      </div>
      <div style="padding:32px;text-align:center">
        <!-- 門禁燈號 -->
        <div id="access-light" style="width:24px;height:24px;border-radius:50%;
             background:var(--red);box-shadow:0 0 20px var(--red);
             margin:0 auto 16px;transition:all .5s"></div>

        <div id="access-text" style="font-size:22px;font-weight:700;
             letter-spacing:4px;color:var(--red);transition:all .5s">
          ACCESS DENIED
        </div>
        <div id="access-sub" style="font-size:12px;color:var(--text-dim);
             margin-top:8px;transition:all .5s">
          當前權限：USER
            <%= currentRole %>
          </span>
        </div>
        <div id="flag-display" style="display:none;margin-top:12px;
             font-size:14px;color:var(--amber);font-family:var(--font);
             letter-spacing:2px"></div>
      </div>
    </div>
  </div>

  <!-- 操作區 -->
  <div style="border:1px solid var(--border);border-radius:4px;
              padding:16px;background:rgba(255,255,255,.02);margin-bottom:14px" class="fi">

    <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
      <button class="btn btn-s" onclick="checkCookie()">[ 驗證權限 ]</button>
      <% if (!hintUsed) { %>
      <button class="btn btn-a" onclick="useHint()" id="hint-btn">
        [ 需要提示 (-50pt) ]
      </button>
      <% } %>
    </div>

    <div id="err-msg" style="display:none;margin-top:10px"></div>

    <div id="hint-box"
      style="display:<%= hintUsed ? 'block' : 'none' %>;margin-top:12px">
      <div class="alert alert-b">
        💡 提示：cookies是否可以修改呢？
      </div>
    </div>

    <div class="score-row" style="margin-top:10px">
      預計得分：<span class="sc-cur" id="sc"><%= score %></span>
      / <span class="sc-max">120</span> pt
      <% if (wrong > 0) { %>
      &nbsp;·&nbsp; 答錯 <%= wrong %> 次（-20/次）
      <% } %>
      <% if (hintUsed) { %>
      &nbsp;·&nbsp; <span style="color:var(--red)">已使用提示（-50）</span>
      <% } %>
    </div>
  </div>

<!-- 成功動畫區 -->
    <div id="pass-area" style="display:none;margin-bottom:14px">
      <div class="term">
        <div class="term-body" id="cookie-output" style="min-height:120px"></div>
      </div>
      <div id="next-btn-area" style="display:none;margin-top:12px">
        <a href="/level/7" class="btn btn-s">進入第7關 →</a>
      </div>
    </div>

    <div class="pg-nav">
      <a href="/" class="btn btn-d">← 返回選單</a>
    </div>
  </div>

<script>
function useHint() {
  fetch('/level/6/hint', { method: 'POST' })
  .then(r => r.json())
  .then(d => {
    document.getElementById('hint-btn').style.display = 'none';
    document.getElementById('hint-box').style.display = 'block';
    const scEl = document.getElementById('sc');
    if (scEl) scEl.textContent = d.score;  });
}

function checkCookie() {
  fetch('/level/6/check', { method: 'POST' })
  .then(r => r.json())
  .then(d => {
    if (d.success) {
      // 更新門禁燈號
      const light = document.getElementById('access-light');
      const text  = document.getElementById('access-text');
      const sub   = document.getElementById('access-sub');
      const flag  = document.getElementById('flag-display');

      light.style.background  = 'var(--green)';
      light.style.boxShadow   = '0 0 20px var(--green)';
      text.style.color        = 'var(--green)';
      text.textContent        = 'ACCESS GRANTED';
      sub.textContent         = '身分驗證成功：role = admin';
      flag.style.display      = 'block';
      flag.textContent        = d.flag;

      document.getElementById('err-msg').style.display  = 'none';
      document.getElementById('pass-area').style.display = 'block';
      const scEl = document.getElementById('sc');
      if (scEl) scEl.textContent = d.score;
      runCookieAnimation(d.score, d.flag);
      } else {
        const err = document.getElementById('err-msg');
        const scEl = document.getElementById('sc');
        const roleEl = document.getElementById('role-display');

        if (roleEl) roleEl.textContent = d.currentRole;
        if (scEl) scEl.textContent = d.score;

        if (err) {
          err.style.display = 'block';
          err.innerHTML = `<div class="alert alert-r">
            ✗ 權限不足。<br>
            <div style="margin-top:4px;font-size:11px;color:var(--amber)">
              ⭐ 目前預計得分：${d.score} pt（已嘗試 ${d.wrong} 次）
            </div>
          </div>`;
        }
      }
  });
}

function runCookieAnimation(score, flag) {
  const output = document.getElementById('cookie-output');
  output.innerHTML = '';
  const lines = [
    { text: '$ document.cookie = "role=admin"', class: 't-d', delay: 0 },
    { text: '發送請求至伺服器...', class: 't-d', delay: 600 },
    { text: '後端讀取 cookie: role=admin', class: 't-d', delay: 1200 },
    { text: '──────────────────────────────', class: 't-d', delay: 1600 },
    { text: '✓ 身分驗證通過！', class: 't-g', delay: 2000 },
    { text: `<span style="color:var(--amber)">${flag}</span>`, class: '', delay: 2600 },
    { text: '──────────────────────────────', class: 't-d', delay: 3200 },
    { text: `本關得分：<span style="color:var(--amber)">${score} pt</span>`, class: 't-a', delay: 3600 },
  ];
  lines.forEach(line => {
    setTimeout(() => {
      const div = document.createElement('div');
      div.innerHTML = line.text;
      if (line.class) div.className = line.class;
      div.style.animation = 'fadeIn .3s ease';
      output.appendChild(div);
    }, line.delay);
  });
  setTimeout(() => {
    document.getElementById('next-btn-area').style.display = 'block';
  }, 4400);
}
</script>

<%- include('../partials/footer') %>
