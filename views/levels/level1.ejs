<%- include('../partials/header', { pageTitle: 'Lv1 ' }) %>

<style>
/* ── 第1關：郵件介面版型 ── */
.inbox-layout {
  display: grid;
  grid-template-columns: 240px 1fr;
  border: 1px solid var(--border);
  border-radius: 4px;
  overflow: hidden;
  min-height: 500px;
  background: #090909;
}

/* 左側信件列表 */
.inbox-sb {
  background: #080808;
  border-right: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.inbox-sb-header {
  padding: 10px 14px 8px;
  font-size: 10px;
  color: var(--text-dim);
  letter-spacing: 2px;
  border-bottom: 1px solid var(--border);
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-shrink: 0;
}
.inbox-sb-count {
  background: var(--red);
  color: #fff;
  font-size: 9px;
  padding: 1px 5px;
  border-radius: 8px;
}
.inbox-list {
  overflow-y: auto;
  flex: 1;
}

/* 單一信件列表項目 */
.inbox-item {
  padding: 10px 14px;
  border-left: 3px solid transparent;
  border-bottom: 1px solid rgba(255,255,255,.04);
  cursor: pointer;
  transition: background .12s;
  position: relative;
}
.inbox-item:hover { background: rgba(255,255,255,.04); }
.inbox-item.active {
  background: rgba(74,246,38,.06);
  border-left-color: var(--green);
}
.inbox-item.unread .i-from { font-weight: 700; }
.i-from {
  font-size: 11px;
  color: var(--text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 2px;
}
.i-subject {
  font-size: 11px;
  color: var(--text-dim);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 3px;
}
.i-meta {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 10px;
  color: var(--text-dim);
}
.i-tag {
  padding: 0px 5px;
  border-radius: 2px;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: .5px;
}
/* 未讀圓點 */
.unread-dot {
  width: 6px; height: 6px;
  border-radius: 50%;
  background: var(--green);
  position: absolute;
  top: 14px; right: 10px;
  flex-shrink: 0;
}

/* 分隔線 */
.inbox-divider {
  padding: 4px 14px;
  font-size: 9px;
  color: var(--text-dim);
  letter-spacing: 2px;
  background: rgba(255,255,255,.02);
  border-bottom: 1px solid var(--border);
  border-top: 1px solid var(--border);
}

/* 右側信件內容 */
.inbox-content {
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.mail-toolbar {
  background: #0a0a0a;
  border-bottom: 1px solid var(--border);
  padding: 6px 16px;
  display: flex;
  align-items: center;
  gap: 10px;
  flex-shrink: 0;
  font-size: 11px;
  color: var(--text-dim);
}
.mail-scroll {
  flex: 1;
  overflow-y: auto;
  padding: 20px;
}
.mail-hd {
  padding-bottom: 14px;
  border-bottom: 1px solid var(--border);
  margin-bottom: 18px;
}
.mail-title { font-size: 16px; font-weight: 700; margin-bottom: 10px; }
.mail-meta-row {
  display: grid;
  grid-template-columns: 40px 1fr;
  gap: 2px 8px;
  font-size: 11px;
  color: var(--text-dim);
  line-height: 1.9;
}
.mail-meta-row .label { color: var(--text-dim); }
.mail-meta-row .val   { color: var(--text); }
.mail-meta-row .susp  { color: var(--red); }
.mail-body { font-size: 13px; line-height: 2; color: var(--text); }
.mail-body p { margin-bottom: 12px; }
.mail-link {
  color: var(--blue);
  text-decoration: underline;
  cursor: pointer;
  font-size: 12px;
  word-break: break-all;
  font-family: var(--font);
}

/* 判斷區 */
.judge-box {
  margin-top: 24px;
  padding: 14px 16px;
  border: 1px solid var(--border);
  border-radius: 4px;
  background: rgba(255,255,255,.02);
}
.judge-note {
  font-size: 12px;
  color: var(--text-dim);
  margin-bottom: 10px;
  font-family: var(--font);
}
.judge-btns { display: flex; gap: 8px; flex-wrap: wrap; }

/* 廣告信標記 */
.ad-badge {
  display: inline-block;
  font-size: 9px;
  padding: 1px 5px;
  border: 1px solid var(--amber);
  color: var(--amber);
  border-radius: 2px;
  vertical-align: middle;
  margin-left: 6px;
}

@media (max-width: 640px) {
  .inbox-layout { grid-template-columns: 1fr; }
  .inbox-sb { border-right: none; border-bottom: 1px solid var(--border); max-height: 220px; }
}
</style>

<div class="wrap-wide">

  <!-- 頁面標題 -->
  <div class="pg-header fi">
    <div class="pg-lv">LV 01 / 10 </div>
    <div class="pg-title">Email Phishing Detection</div>
    <div class="pg-sub">滿分 100 pt &nbsp;·&nbsp; 每答錯 -10，最低 10</div>
  </div>

  <!-- 任務說明 -->
  <div class="term fi" style="margin-bottom:16px">
    <div class="term-bar">
      <span class="dot dot-r"></span><span class="dot dot-y"></span><span class="dot dot-g"></span>
      <span style="margin-left:8px">mission-briefing</span>
    </div>
    <div class="term-body" style="font-size:13px">
      <div class="t-d">$ cat mission.txt</div>
      <div style="margin-top:6px">
        您收到一封新郵件，請立即確認！
      </div>
    </div>
  </div>

  <!-- 郵件用戶端 -->
  <div class="inbox-layout fi">

    <!-- ── 左側：收件匣列表 ── -->
    <div class="inbox-sb">
      <div class="inbox-sb-header">
        <span>INBOX</span>
        <span class="inbox-sb-count"><%= 1 + inboxExtra.length %></span>
      </div>

      <div class="inbox-list">
        <!-- 需要判斷的信件（標 ★） -->
        <div class="inbox-divider">★ 待確認</div>
        <div class="inbox-item unread active" id="main-item" onclick="showMain()">
          <div class="unread-dot"></div>
          <div class="i-from"><%= mail.from %></div>
          <div class="i-subject"><%= mail.subject %></div>
          <div class="i-meta">
            <span class="i-tag" style="background:rgba(74, 246, 38,.2);color:var(--green);border:1px solid rgba(74, 246, 38,.3)">新郵件</span>
            <span><%= mail.time %></span>
          </div>
        </div>

        <!-- 其他背景信件 -->
        <div class="inbox-divider">郵件匣
        </div>
        <% inboxExtra.forEach(ex => { %>
        <div class="inbox-item" id="item-<%= ex.id %>" onclick="showExtra('<%= ex.id %>')">
          <div class="i-from"><%= ex.from %></div>
          <div class="i-subject"><%= ex.subject %></div>
          <div class="i-meta">
            <span class="i-tag"
              style="background:<%= ex.tagColor === '#4af626' ? 'rgba(74,246,38,.15)' : 'rgba(255,170,0,.15)' %>;
                     color:<%= ex.tagColor %>;
                     border:1px solid <%= ex.tagColor === '#4af626' ? 'rgba(74,246,38,.3)' : 'rgba(255,170,0,.3)' %>">
              <%= ex.tag %>
            </span>
            <span><%= ex.time %></span>
          </div>
        </div>
        <% }) %>
      </div>
    </div>

    <!-- ── 右側：信件內容區 ── -->
    <div class="inbox-content">
      <div class="mail-toolbar">
        <span id="toolbar-label">★ 新郵件</span>
      </div>

      <div class="mail-scroll" id="mail-content-area">

        <!-- ★ 主要信件（預設顯示） -->
        <div id="view-main">
          <div class="mail-hd">
            <div class="mail-title"><%= mail.subject %></div>
            <div class="mail-meta-row">
              <span class="label">From:</span>
              <span class="val">
                <%= mail.from %><% if (mail.fromSuspicious) { %><% } %>
              </span>
              <span class="label">To:</span>
              <span class="val">student@campus.edu.tw</span>
              <span class="label">Date:</span>
              <span class="val"><%= mail.time %></span>
            </div>
          </div>

          <div class="mail-body">
            <% mail.body.forEach(p => { %>
            <p><%= p %></p>
            <% }) %>

            <% if (mail.link) { %>
            <p style="margin-top:14px">
              請點擊以下連結：<br>
              <span class="mail-link" onclick="openPhish()"><%= mail.link %></span>
            </p>
            <% } %>
          </div>

          <!-- 判斷區 -->
          <% if (!judged) { %>
          <div class="judge-box" id="judge-box">
            <div class="judge-note">$ ./analyze.sh — 這封信件是否為釣魚郵件？</div>
            <div class="judge-btns">
              <button class="btn btn-s" onclick="judge('phish')">[ ✓ 是，這是釣魚！]</button>
              <button class="btn btn-r" onclick="judge('normal')">[ ✗ 不是，正常信件 ]</button>
            </div>
            <div id="judge-err" style="display:none;margin-top:10px"></div>
          </div>
          <% } %>

          <!-- 過關區 -->
          <% if (judged) { %>
          <div class="alert alert-g" style="margin-top:18px">
            ✓ 判斷正確！<br>
            <span style="font-size:12px;color:var(--text-dim)">
              別忘記用 F12 → Elements 查看此頁面的 HTML 原始碼，裡面藏有重要情報。
            </span>
          </div>
          <button class="btn btn-s" style="margin-top:10px" onclick="complete()">
            [ 記錄得分，繼續追查 ] →
          </button>
          <% } else { %>
          <div id="pass-box" style="display:none;margin-top:18px">
            <div class="alert alert-g">
              ✓ 判斷正確！<br>
            </div>
            <button class="btn btn-s" style="margin-top:10px" onclick="complete()">
              前往下一關 →
            </button>
          </div>
          <% } %>

          <!-- 得分列 -->
          <div class="score-row" style="margin-top:14px">
            預計得分：<span class="sc-cur" id="sc"><%= score %></span>
            / <span class="sc-max">100</span> pt
            <% if (wrong > 0) { %>
            &nbsp;·&nbsp; 已答錯 <%= wrong %> 次（每次 -10）
            <% } %>
          </div>
        </div>

        <!-- 背景信件內容（動態切換，初始隱藏） -->
        <div id="view-extra" style="display:none">
          <div class="mail-hd" id="ex-hd">
            <div class="mail-title" id="ex-title"></div>
            <div class="mail-meta-row">
              <span class="label">From:</span>
              <span class="val" id="ex-from"></span>
              <span class="label">To:</span>
              <span class="val">student@campus.edu.tw</span>
              <span class="label">Date:</span>
              <span class="val" id="ex-time"></span>
            </div>
          </div>
          <div class="mail-body" id="ex-body"></div>
          <div style="margin-top:20px;padding-top:14px;border-top:1px solid var(--border)">
            <button class="btn btn-d" style="font-size:11px" onclick="showMain()">
              ← 返回
            </button>
          </div>
        </div>

      </div>
    </div>
  </div>

  <div class="pg-nav" style="margin-top:14px">
    <a href="/" class="btn btn-d">← 返回選單</a>
  </div>
</div>

<!-- 釣魚網站彈出視窗 -->
<div id="phish-overlay"
  style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.88);
         z-index:200;align-items:center;justify-content:center">
  <div style="width:500px;max-width:94vw;border:1px solid #333;border-radius:4px;
              overflow:hidden;box-shadow:0 8px 40px #000">
    <!-- 假瀏覽器網址列 -->
    <div style="background:#1a1a1a;padding:8px 14px;border-bottom:1px solid #333;
                display:flex;align-items:center;gap:8px;font-size:12px;font-family:var(--font)">
      <span style="color:var(--red)">🔓</span>
      <span style="color:#888;word-break:break-all;flex:1;font-size:11px">
        <%= mail.link || '' %>
      </span>
      <button onclick="closePhish()"
        style="background:transparent;border:none;color:#666;cursor:pointer;
               font-size:18px;line-height:1;padding:0 4px">✕</button>
    </div>
    <!-- 偽造登入頁 -->
    <div style="padding:36px;background:#f4f4f4;color:#333">
      <div style="text-align:center;margin-bottom:22px">
        <div style="font-size:30px">🏫</div>
        <div style="font-size:17px;font-weight:700;color:#1a237e;margin-top:6px">國立XX大學 校務系統</div>
        <div style="font-size:11px;color:#888;margin-top:3px">Campus Information System</div>
      </div>
      <div style="margin-bottom:12px">
        <label style="font-size:12px;color:#555;display:block;margin-bottom:4px">學號</label>
        <input style="width:100%;padding:8px 10px;border:1px solid #ccc;border-radius:3px;font-size:13px">
      </div>
      <div style="margin-bottom:16px">
        <label style="font-size:12px;color:#555;display:block;margin-bottom:4px">密碼</label>
        <input type="password" style="width:100%;padding:8px 10px;border:1px solid #ccc;border-radius:3px;font-size:13px">
      </div>
      <button style="width:100%;background:#1a237e;color:#fff;border:none;border-radius:3px;
                     padding:10px;font-size:14px;cursor:pointer">登入</button>
      <div style="margin-top:10px;padding:8px;background:#fff3cd;border:1px solid #ffc107;
                  border-radius:3px;font-size:11px;color:#856404">
        ⚠ 瀏覽器警告：此網站的安全憑證無效
      </div>
    </div>
  </div>
</div>

<script>
// ── 信件資料（背景信件內容，供 JS 切換顯示用） ──
const EXTRA_DATA = <%- JSON.stringify(inboxExtra) %>;
let wrong = <%= wrong %>;

// 顯示主要信件（★ 待判斷）
function showMain() {
  document.getElementById('view-main').style.display = 'block';
  document.getElementById('view-extra').style.display = 'none';
  document.getElementById('toolbar-label').textContent = '★ 新郵件';
  // 更新左側 active 狀態
  document.querySelectorAll('.inbox-item').forEach(el => el.classList.remove('active'));
  document.getElementById('main-item').classList.add('active');
}

// 顯示背景信件
function showExtra(id) {
  const mail = EXTRA_DATA.find(m => m.id === id);
  if (!mail) return;

  document.getElementById('ex-title').textContent = mail.subject;
  document.getElementById('ex-from').textContent  = mail.from;
  document.getElementById('ex-time').textContent  = mail.time;
  document.getElementById('ex-body').innerHTML =
    mail.body.map(p => `<p>${p}</p>`).join('');

  document.getElementById('view-main').style.display  = 'none';
  document.getElementById('view-extra').style.display = 'block';
  document.getElementById('toolbar-label').textContent = mail.subject;

  // 更新左側 active 狀態
  document.querySelectorAll('.inbox-item').forEach(el => el.classList.remove('active'));
  const item = document.getElementById('item-' + id);
  if (item) item.classList.add('active');
}

function openPhish() {
  document.getElementById('phish-overlay').style.display = 'flex';
}
function closePhish() {
  document.getElementById('phish-overlay').style.display = 'none';
}

// 送出判斷
function judge(answer) {
  fetch('/level/1/judge', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ answer }),
  })
  .then(r => r.json())
  .then(d => {
    if (d.correct) {
      // 過關：隱藏判斷按鈕，顯示過關區
      const jb = document.getElementById('judge-box');
      if (jb) jb.style.display = 'none';
      document.getElementById('pass-box').style.display = 'block';
    } else {
      wrong = d.wrong;
      document.getElementById('sc').textContent = d.score;
      const err = document.getElementById('judge-err');
      if (err) {
        err.style.display = 'block';
        err.innerHTML = `<div class="alert alert-r" style="margin-top:0">
          ✗ 判斷錯誤。<br>
          <span style="font-size:12px">${d.hint}</span>
          <div style="margin-top:6px;font-size:11px;color:var(--amber)">
            ⭐ 目前預計得分：${d.score} pt（已答錯 ${d.wrong} 次）
          </div>
        </div>`;
      }
    }
  });
}

// 記錄得分並前往下一關
function complete() {
  fetch('/level/1/complete', { method: 'POST' })
  .then(r => r.json())
  .then(d => {
    if (d.redirect) window.location.href = d.redirect;
  });
}
</script>

<%- include('../partials/footer') %>
