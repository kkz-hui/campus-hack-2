<%- include('../partials/header', { pageTitle: 'Lv5 HTML 原始碼' }) %>

<!--FLAG_PART1: CAMPUS-->

<div class="wrap">

  <div class="pg-header fi">
    <div class="pg-lv">LV 05 / 06 &nbsp;·&nbsp; HTML 原始碼</div>
    <div class="pg-title">Source Code Review</div>
    <div class="pg-sub">
      滿分 100 pt &nbsp;·&nbsp; 每答錯 -15 &nbsp;·&nbsp; 使用提示 -40 &nbsp;·&nbsp; 最低 0
    </div>
  </div>


  <!-- 假的資源下載頁面（內含 FLAG 在 HTML comment） -->
  <div class="fi" style="margin-bottom:16px">
    <div style="border:1px solid var(--border);border-radius:4px;background:#0a0a0a">
      <div style="background:linear-gradient(90deg,#1a237e,#283593);
                  padding:14px 20px;border-radius:4px 4px 0 0">
        <div style="color:#fff;font-size:15px;font-weight:700">🏫 校內資源下載中心</div>
        <div style="color:rgba(255,255,255,.6);font-size:11px;margin-top:2px">
          已登入：王小明 &nbsp;|&nbsp; 權限：student
        <p style="margin-top:12px;font-size:12px;color:var(--text-dim)">
          如需更改權限，請聯繫系統管理員。
        </p>
        </div>
      </div>
    </div>
  </div>

<!-- admin panel: /admin/dashboard-->
<!-- 輸入區 -->
  <div style="border:1px solid var(--border);border-radius:4px;
              padding:16px;background:rgba(255,255,255,.02);margin-bottom:14px" class="fi">

    <!-- FLAG 輸入 admin panel: /admin/dashboard-->
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px;flex-wrap:wrap">
      <span style="font-size:13px;color:var(--text-dim);min-width:60px">FLAG =</span>
      <input type="text" id="ans-flag" class="inp"
        style="max-width:280px;flex:1" placeholder="" autocomplete="off">
    </div>

    <!-- cookie 輸入 role=user-->
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:16px;flex-wrap:wrap">
      <span style="font-size:13px;color:var(--text-dim);min-width:60px">cookie =</span>
      <input type="text" id="ans-cookie" class="inp"
        style="max-width:280px;flex:1" placeholder="" autocomplete="off">
    </div>

    <!-- 按鈕列 -->
    <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
      <button class="btn btn-s" onclick="verify()">[ 確認 ]</button>
      <% if (!hintUsed) { %>
      <button class="btn btn-a" onclick="useHint()" id="hint-btn">
        [ 需要提示 (-40pt) ]
      </button>
      <% } %>
    </div>

    <div id="err-msg" style="display:none;margin-top:10px"></div>

    <div id="hint-box"
      style="display:<%= hintUsed ? 'block' : 'none' %>;margin-top:12px">
      <div class="alert alert-b">
        💡 提示：原始碼似乎藏了什麼。
      </div>
    </div>

    <div class="score-row" style="margin-top:10px">
      預計得分：<span class="sc-cur" id="sc"><%= score %></span>
      / <span class="sc-max">100</span> pt
      <% if (wrong > 0) { %>
      &nbsp;·&nbsp; 答錯 <%= wrong %> 次（-15/次）
      <% } %>
      <% if (hintUsed) { %>
      &nbsp;·&nbsp; <span style="color:var(--red)">已使用提示（-40）</span>
      <% } %>
    </div>
  </div>

    <div class="score-row" style="margin-top:10px">
      預計得分：<span class="sc-cur" id="sc"><%= score %></span>
      / <span class="sc-max">100</span> pt
      <% if (wrong > 0) { %>
      &nbsp;·&nbsp; 答錯 <%= wrong %> 次（-15/次）
      <% } %>
      <% if (hintUsed) { %>
      &nbsp;·&nbsp; <span style="color:var(--red)">已使用提示（-40）</span>
      <% } %>
    </div>
  </div>

  <!-- 成功動畫區 -->
  <div id="pass-area" style="display:none;margin-bottom:14px">
    <div class="term">
      <div class="term-body" id="flag-output" style="min-height:120px"></div>
    </div>
    <div id="next-btn-area" style="display:none;margin-top:12px">
      <a href="/level/6" class="btn btn-s">進入第6關 →</a>
    </div>
  </div>

  <div class="pg-nav">
    <a href="/" class="btn btn-d">← 返回選單</a>
  </div>
</div>

<script>
function useHint() {
  fetch('/level/5/hint', { method: 'POST' })
  .then(r => r.json())
  .then(d => {
    document.getElementById('hint-btn').style.display = 'none';
    document.getElementById('hint-box').style.display = 'block';
    document.getElementById('sc').textContent = d.score;
  });
}

function verify() {
  const flag   = document.getElementById('ans-flag').value.trim();
  const cookie = document.getElementById('ans-cookie').value.trim();

  fetch('/level/5/verify', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ flag, cookie }),
  })
  .then(r => r.json())
  .then(d => {
    if (d.correct) {
      document.getElementById('err-msg').style.display  = 'none';
      document.getElementById('pass-area').style.display = 'block';
      runFlagAnimation(d.score);
    } else {
      document.getElementById('sc').textContent = d.score;
      const err = document.getElementById('err-msg');
      err.style.display = 'block';
      err.innerHTML = `<div class="alert alert-r">
        ✗ ${d.msg}
        <div style="margin-top:4px;font-size:11px;color:var(--amber)">
          ⭐ 目前預計得分：${d.score} pt
        </div>
      </div>`;
    }
  });
}

function runFlagAnimation(score) {
  const output = document.getElementById('flag-output');
  output.innerHTML = '';
  const lines = [
    { text: '$ grep -r "FLAG" page_source.html', class: 't-d', delay: 0 },
    { text: '掃描中...', class: 't-d', delay: 600 },
    { text: '──────────────────────────────', class: 't-d', delay: 1200 },
    { text: '✓ 發現隱藏內容！', class: 't-g', delay: 1800 },
    { text: 'FLAG_PART1: CAMPUS', class: '', delay: 2400 },
    { text: 'cookie: role=user', class: '', delay: 3000 },
    { text: '──────────────────────────────', class: 't-d', delay: 3600 },
    { text: `本關得分：<span style="color:var(--amber)">${score} pt</span>`, class: 't-a', delay: 4000 },
  ];
  lines.forEach(line => {
    setTimeout(() => {
      const div = document.createElement('div');
      div.innerHTML = line.text;
      if (line.class) div.className = line.class;
      div.style.animation = 'fadeIn .3s ease';
      output.appendChild(div);
    }, line.delay);
  });
  setTimeout(() => {
    document.getElementById('next-btn-area').style.display = 'block';
  }, 4800);
}

document.getElementById('ans').addEventListener('keydown', e => {
  if (e.key === 'Enter') verify();
});
</script>

<%- include('../partials/footer') %>
