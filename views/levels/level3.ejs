<%- include('../partials/header', { pageTitle: 'Lv3 ' }) %>

<div class="wrap">

  <div class="pg-header fi">
    <div class="pg-lv">LV 03 / 10 </div>
    <div class="pg-title">Authentication Bypass</div>
    <div class="pg-sub">
      滿分 100 pt &nbsp;·&nbsp; 每答錯 -10 &nbsp;·&nbsp; 使用提示 -30 &nbsp;·&nbsp; 最低 0
    </div>
  </div>


  <!-- 假校務系統登入頁 -->
  <div style="max-width:400px;margin:0 auto" class="fi">

    <!-- 假瀏覽器網址列 -->
    <div style="background:#111;border:1px solid var(--border);border-radius:4px 4px 0 0;
                padding:7px 14px;display:flex;align-items:center;gap:8px;
                font-size:11px;font-family:var(--font);color:#666">
      <span style="color:var(--red)">🔓</span>
      <span>campus-verify.sch00l-p0rtal.xyz/login</span>
    </div>

    <!-- 登入表單 -->
    <div style="border:1px solid var(--border);border-top:none;border-radius:0 0 4px 4px;
                background:#000000;color:#333;padding:32px">
      <div style="text-align:center;margin-bottom:24px">
        <div style="font-size:30px">🏫</div>
        <div style="font-size:17px;font-weight:700;color:#c0c0c5;margin-top:6px">
          國立XX大學 校務系統
        </div>
        <div style="font-size:11px;color:#888;margin-top:3px">
          Campus Information System
        </div>
      </div>

        <form id="login-form" onsubmit="doLogin(event)">        <!-- 學號 -->
        <div style="margin-bottom:14px">
          <label style="font-size:12px;color:#555;display:block;margin-bottom:4px">
            學號 / Student ID
          </label>
          <input type="text" name="username" autocomplete="off"
            style="width:100%;padding:8px 10px;border:1px solid #ccc;
                   border-radius:3px;font-size:13px;font-family:monospace">
        </div>

        <!-- 密碼（第一次失敗不給提示，需點按鈕） -->
        <div style="margin-bottom:6px">
          <label style="font-size:12px;color:#555;display:block;margin-bottom:4px;
                        display:flex;justify-content:space-between;align-items:center">
            <span>密碼 / Password</span>
            <% if (hintUsed) { %>
            <span style="color:#e65100;font-size:11px">提示：與個人信息有關</span>
            <% } %>
          </label>
          <input type="password" name="password"
            style="width:100%;padding:8px 10px;border:1px solid #ccc;
                   border-radius:3px;font-size:13px">
        </div>

        <!-- 錯誤訊息 -->
        <div id="err-msg" style="display:none;margin-bottom:10px"></div>

        <button type="submit"
          style="width:100%;background:#1a237e;color:#fff;border:none;
                 border-radius:3px;padding:10px;font-size:14px;cursor:pointer;
                 margin-bottom:10px">
          登入
        </button>
      </form>

      <!-- 登入成功動畫區（初始隱藏） -->
    <div id="pass-area" style="display:none;margin-top:16px">

    <div class="term-body" id="login-output" style="min-height:140px"></div>
    </div>
    <div id="next-btn-area" style="display:none;margin-top:12px">
        <a href="/level/4" class="btn btn-s">進入第4關 →</a><br>
        <a href="/" class="btn btn-d" style="margin-right:10px">← 返回選單</a>
      </div>
    </div>

      <!-- 提示按鈕（未使用時才顯示） -->
      <% if (!hintUsed) { %>
      <button onclick="useHint()"
        style="width:100%;background:transparent;border:1px solid #ff9800;
               color:#e65100;border-radius:3px;padding:7px;font-size:12px;
               cursor:pointer;font-family:monospace">
        💡 需要提示（得分 -30）
      </button>
      <% } %>
    </div>

    <!-- 得分列 -->
    <div class="score-row" style="margin-top:10px;text-align:center">
      預計得分：<span class="sc-cur" id="sc"><%= score %></span>
      / <span class="sc-max">100</span> pt
      <% if (wrong > 0) { %>
      &nbsp;·&nbsp; 答錯 <%= wrong %> 次（-10/次）
      <% } %>
      <% if (hintUsed) { %>
      &nbsp;·&nbsp; <span style="color:var(--red)">已使用提示（-30）</span>
      <% } %>
    </div>
  </div>

  <div class="pg-nav" style="margin-top:24px">
    <a href="/" class="btn btn-d">← 返回選單</a>
  </div>
</div>

<script>
function useHint() {
  fetch('/level/3/hint', { method: 'POST' })
  .then(() => window.location.reload());
}

function runLoginAnimation(score) {
  // 隱藏登入表單，顯示動畫區
  document.querySelector('form').style.display   = 'none';
  document.querySelector('.btn-amber') && (document.querySelector('.btn-amber').style.display = 'none');
  document.getElementById('pass-area').style.display = 'block';

  const output = document.getElementById('login-output');
  output.innerHTML = '';

  const lines = [
    { text: '$ ./login.sh --user s1234567', class: 't-d', delay: 0 },
    { text: 'Authenticating...', class: 't-d', delay: 600 },
    { text: '✓ 登入成功！', class: 't-g', delay: 1400 },
    { text: '──────────────────────────────', class: 't-d', delay: 1800 },
    { text: '使用者：王小明', class: '', delay: 2200 },
    { text: '學號：s1234567', class: '', delay: 2700 },
    { text: '身分別：student', class: '', delay: 3200 },
    { text: '──────────────────────────────', class: 't-d', delay: 4200 },
    { text: `本關得分：<span style="color:var(--amber)">${score} pt</span>`, class: 't-a', delay: 4700 },
  ];

  lines.forEach(line => {
    setTimeout(() => {
      const div = document.createElement('div');
      div.innerHTML = line.text;
      if (line.class) div.className = line.class;
      div.style.animation = 'fadeIn .3s ease';
      output.appendChild(div);
    }, line.delay);
  });

  setTimeout(() => {
    document.getElementById('next-btn-area').style.display = 'block';
  }, 5400);
}

function doLogin(e) {
  e.preventDefault();
  const username = document.querySelector('input[name="username"]').value;
  const password = document.querySelector('input[name="password"]').value;

  fetch('/level/3/login', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ username, password }),
  })
  .then(r => r.json())
  .then(d => {
    if (d.success) {
      runLoginAnimation(d.score);
    } else {
      const err = document.getElementById('err-msg');
      err.style.display = 'block';
      err.innerHTML = `
        <div style="margin-bottom:10px;padding:8px 10px;background:#ffebee;
                    border:1px solid #ef9a9a;border-radius:3px;
                    font-size:12px;color:#c62828;text-align:center">
          ✗ 帳號或密碼錯誤
          <span style="opacity:.7">（已嘗試 ${d.wrong} 次）</span>
          <div style="margin-top:4px;color:#e65100;font-size:11px">
            ⭐ 目前預計得分：${d.score} pt
          </div>
        </div>`;
      document.getElementById('sc').textContent = d.score;
    }
  });
}

</script>

<%- include('../partials/footer') %>
