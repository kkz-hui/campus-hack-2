<%- include('../partials/header', { pageTitle: 'Lv8 Session 劫持' }) %>

<div class="wrap">

  <div class="pg-header fi">
    <div class="pg-lv">LV 08 / 08 &nbsp;·&nbsp; Session 劫持</div>
    <div class="pg-title">Session Hijacking</div>
    <div class="pg-sub">
      滿分 120 pt &nbsp;·&nbsp; 每答錯 -20 &nbsp;·&nbsp; 使用提示 -40 &nbsp;·&nbsp; 最低 0
    </div>
  </div>

  <!-- 任務說明 -->
  <div class="term fi" style="margin-bottom:16px">
    <div class="term-bar">
      <span class="dot dot-r"></span>
      <span class="dot dot-y"></span>
      <span class="dot dot-g"></span>
      <span style="margin-left:8px">mission-briefing</span>
    </div>
    <div class="term-body">
      <div class="t-d">$ cat mission.txt</div>
      <div style="margin-top:6px;color:var(--text)">
        你找到了一台教師工作站，但 Session 已過期。<br>
        桌上有一張便利貼，仔細看看裡面的內容。<br>
        找到正確的 Session ID，注入到 Cookie 裡重新連線。
      </div>
      <div style="margin-top:8px" class="t-a">
        ⚠ 操作方式：F12 → Application → Cookies → localhost:3000<br>
        <span style="color:var(--text-dim);font-size:12px">
          找到 PHPSESSID，雙擊 Value 修改成正確的 Session ID。
        </span>
      </div>
    </div>
  </div>

  <!-- 教師工作站畫面 -->
  <div class="fi" style="margin-bottom:16px;display:grid;
       grid-template-columns:1fr 200px;gap:16px;align-items:start">

    <!-- 左側：工作站螢幕 -->
    <div style="border:1px solid var(--border);border-radius:4px;background:#0a0a0a">
      <div style="background:#111;padding:8px 14px;border-bottom:1px solid var(--border);
                  font-size:11px;color:var(--text-dim);font-family:var(--font)">
        📺 TEACHER_WS_03 — SSH Session
      </div>
      <div style="padding:28px;text-align:center">
        <div style="font-size:36px;margin-bottom:14px">⏱</div>
        <div style="font-size:20px;font-weight:700;letter-spacing:4px;
                    color:var(--red);margin-bottom:8px">
          SESSION EXPIRED
        </div>
        <div style="font-size:12px;color:var(--text-dim);margin-bottom:16px">
          連線逾時，PHPSESSID 已失效
        </div>
        <div class="term" style="text-align:left;max-width:400px;margin:0 auto">
          <div class="term-bar">
            <span class="dot dot-r"></span>
            <span class="dot dot-y"></span>
            <span class="dot dot-g"></span>
            <span style="margin-left:8px">session.log</span>
          </div>
          <div class="term-body" style="font-size:12px">
            <div class="t-d">[ERROR] Session validation failed</div>
            <div class="t-d">[ERROR] PHPSESSID=expired_session</div>
            <div class="t-d">[INFO]  Last valid session: Teacher_Wang</div>
            <div class="t-d">[INFO]  Permissions: READ/WRITE/ADMIN</div>
          </div>
        </div>
      </div>
    </div>

    <!-- 右側：便利貼（Session ID 藏在雜訊中） -->
    <div style="background:#f5e642;color:#2a1a00;padding:16px;border-radius:2px;
                font-family:'Courier New',monospace;font-size:11px;line-height:2.1;
                box-shadow:4px 4px 12px rgba(0,0,0,.5);
                transform:rotate(-1.5deg)">
      <div style="font-weight:700;font-size:13px;margin-bottom:8px">📌 備忘</div>
      <div>下週三 開會 14:00</div>
      <div>印表機 IP: 192.168.1.44</div>
      <div>訂書針放抽屜</div>
      <div style="color:#5a3a00">abc123</div>
      <div>wifi: CampusNet_5G</div>
      <div>圖書館還書 3/20</div>
      <div>找IT修投影機</div>
    </div>
  </div>

  <!-- 操作區 -->
  <div style="border:1px solid var(--border);border-radius:4px;
              padding:16px;background:rgba(255,255,255,.02);margin-bottom:14px" class="fi">
    <div style="font-size:13px;margin-bottom:12px">
      修改完 PHPSESSID 後，按「重新連線」：
    </div>

    <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
      <button class="btn btn-s" onclick="reconnect()">[ 重新連線 ]</button>
      <% if (!hintUsed) { %>
      <button class="btn btn-a" onclick="useHint()" id="hint-btn">
        [ 需要提示 (-40pt) ]
      </button>
      <% } %>
    </div>

    <div id="err-msg" style="display:none;margin-top:10px"></div>

    <div id="hint-box"
      style="display:<%= hintUsed ? 'block' : 'none' %>;margin-top:12px">
      <div class="alert alert-b">
        💡 提示：<br>
        1. 仔細看便利貼裡的每一行內容<br>
        2. 找到那個像是密碼的字串<br>
        3. F12 → Application → Cookies → localhost:3000<br>
        4. 找到 <code style="color:var(--amber)">PHPSESSID</code><br>
        5. 雙擊 Value，改成便利貼上找到的字串<br>
        6. 按 Enter，回來點「重新連線」
      </div>
    </div>

    <div class="score-row" style="margin-top:10px">
      預計得分：<span class="sc-cur" id="sc"><%= score %></span>
      / <span class="sc-max">120</span> pt
      <% if (wrong > 0) { %>
      &nbsp;·&nbsp; 答錯 <%= wrong %> 次（-20/次）
      <% } %>
      <% if (hintUsed) { %>
      &nbsp;·&nbsp; <span style="color:var(--red)">已使用提示（-40）</span>
      <% } %>
    </div>
  </div>

  <!-- 成功動畫區 -->
  <div id="pass-area" style="display:none;margin-bottom:14px">
    <div class="term">
      <div class="term-bar">
        <span class="dot dot-r"></span>
        <span class="dot dot-y"></span>
        <span class="dot dot-g"></span>
        <span style="margin-left:8px">session-hijack.sh</span>
      </div>
      <div class="term-body" id="session-output" style="min-height:140px"></div>
    </div>
    <div id="next-btn-area" style="display:none;margin-top:12px">
      <a href="/" class="btn btn-d" style="margin-right:10px">← 返回選單</a>
      <span style="font-size:12px;color:var(--text-dim)">（第9關建置中）</span>
    </div>
  </div>

  <div class="pg-nav">
    <a href="/" class="btn btn-d">← 返回選單</a>
  </div>
</div>

<script>
function useHint() {
  fetch('/level/8/hint', { method: 'POST' })
  .then(r => r.json())
  .then(d => {
    document.getElementById('hint-btn').style.display = 'none';
    document.getElementById('hint-box').style.display = 'block';
    const scEl = document.getElementById('sc');
    if (scEl) scEl.textContent = d.score;
  });
}

function reconnect() {
  fetch('/level/8/connect', {
    method: 'POST',
    credentials: 'same-origin',
  })
  .then(r => r.json())
  .then(d => {
    if (d.success) {
      document.getElementById('err-msg').style.display   = 'none';
      document.getElementById('pass-area').style.display = 'block';
      const scEl = document.getElementById('sc');
      if (scEl) scEl.textContent = d.score;
      runSessionAnimation(d.score);
    } else {
      const scEl = document.getElementById('sc');
      if (scEl) scEl.textContent = d.score;
      const err = document.getElementById('err-msg');
      if (err) {
        err.style.display = 'block';
        err.innerHTML = `<div class="alert alert-r">
          ✗ Session 驗證失敗，目前 PHPSESSID =
          <span style="color:var(--amber)">${d.phpsessid}</span><br>
          <span style="font-size:12px">
            請用 F12 → Application → Cookies 修改 PHPSESSID 的值。
          </span>
          <div style="margin-top:4px;font-size:11px;color:var(--amber)">
            ⭐ 目前預計得分：${d.score} pt（已嘗試 ${d.wrong} 次）
          </div>
        </div>`;
      }
    }
  });
}

function runSessionAnimation(score) {
  const output = document.getElementById('session-output');
  output.innerHTML = '';
  const lines = [
    { text: '$ ssh teacher@campus-ws-03', class: 't-d', delay: 0 },
    { text: 'Validating PHPSESSID...', class: 't-d', delay: 600 },
    { text: 'PHPSESSID = abc123', class: 't-a', delay: 1200 },
    { text: '──────────────────────────────', class: 't-d', delay: 1600 },
    { text: '✓ Session 驗證成功！', class: 't-g', delay: 2000 },
    { text: '身分：Teacher_Wang', class: '', delay: 2500 },
    { text: '權限：<span style="color:var(--amber)">READ / WRITE / ADMIN</span>', class: '', delay: 3000 },
    { text: '──────────────────────────────', class: 't-d', delay: 3400 },
    { text: `本關得分：<span style="color:var(--amber)">${score} pt</span>`, class: 't-a', delay: 3800 },
  ];
  lines.forEach(line => {
    setTimeout(() => {
      const div = document.createElement('div');
      div.innerHTML = line.text;
      if (line.class) div.className = line.class;
      div.style.animation = 'fadeIn .3s ease';
      output.appendChild(div);
    }, line.delay);
  });
  setTimeout(() => {
    document.getElementById('next-btn-area').style.display = 'block';
  }, 4600);
}
</script>

<%- include('../partials/footer') %>
