<%- include('partials/header', { pageTitle: '任務完成' }) %>

<div class="wrap" style="text-align:center">

  <div style="padding:48px 0 32px" class="fi">
    <div style="font-size:11px;color:var(--red);letter-spacing:4px;
                font-family:var(--font);margin-bottom:16px">
      ⚠ SYSTEM COMPROMISED ⚠
    </div>
    <div style="font-size:32px;font-weight:700;color:var(--green);
                letter-spacing:5px;text-shadow:0 0 30px rgba(74,246,38,.3);
                margin-bottom:8px">
      MISSION COMPLETE
    </div>
    <div style="font-size:13px;color:var(--text-dim);margin-bottom:32px">
      所有攻擊路徑已還原。入侵者身份確認。
    </div>

    <!-- 完整 FLAG -->
    <div style="display:inline-block;padding:14px 32px;
                border:2px solid var(--green);border-radius:4px;
                font-family:var(--font);font-size:16px;font-weight:700;
                color:var(--green);letter-spacing:2px;margin-bottom:32px;
                box-shadow:0 0 30px rgba(74,246,38,.2)">
      FLAG{CAMPUS_HACK_SYSTEM_BREACH}
    </div>

    <!-- 得分 -->
    <div style="margin-bottom:32px">
      <div style="font-size:13px;color:var(--text-dim);margin-bottom:8px">最終總分</div>
      <div style="font-size:36px;font-weight:700;color:var(--amber)">
        <%= progress.total %> pt
      </div>
      <div style="font-size:12px;color:var(--text-dim);margin-top:4px">
        <%
          const maxTotal = 100+150+100+120+100+120+120+120+100+150;
        %>
        / <%= maxTotal %> pt 滿分
      </div>
    </div>

    <!-- 各關得分 -->
    <div style="max-width:500px;margin:0 auto 32px;text-align:left">
      <div class="term">
        <div class="term-bar">
          <span style="margin-left:8px">score-report.txt</span>
        </div>
        <div class="term-body" style="font-size:12px;line-height:2">
          <%
            const levelNames = {
              1:'詐騙辨識 → 釣魚信件偵測', 2:'Base64 解碼 → 取得學號', 3:'弱密碼登入 → 生日作為密碼',
              4:'目錄遊走 → ../ 讀取 access.log',  5:'HTML 原始碼 → 取得 FLAG與cookie', 6:'Cookie 存取 → 鑽漏洞修改cookie',
              7:'偽造學生證 → 修改localStorage繞過門禁',8:'Session 劫持 → 取得PHPSESSID數值',9:'隱寫術 → steghide提取圖片訊息',
              10:'指令注入 → ping ;cat 竊取最終檔案'
            };
            const maxScores = {
              1:100,2:150,3:100,4:120,5:100,
              6:120,7:120,8:120,9:100,10:150
            };
          %>
          <% for(let i=1; i<=10; i++) { %>
          <div>
            <span class="t-d">Lv<%= String(i).padStart(2,'0') %>
              <%= levelNames[i] %></span>
            &nbsp;
            <span class="t-a">
              <%= progress.scores[i] || 0 %> / <%= maxScores[i] %> pt
            </span>
          </div>
          <% } %>
        </div>
      </div>
    </div>

    <div style="font-size:20px;justify-content:center">
      <span class="t-g">恭喜通關！</span>
    </div>
    <div style="display:flex;gap:12px;justify-content:center">
      <form action="/reset" method="POST">
        <button type="submit" class="btn">重新開始</button>
      </form>
      <a href="/" class="btn btn-d">返回選單</a>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
